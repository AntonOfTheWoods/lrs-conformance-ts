{
  "name": "lrs-conformance-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test ./rewrite/tests/parity-comparison.test.ts ./rewrite/tests/v1-v2-delta-matrix.test.ts ./rewrite/tests/traffic.test.ts ./rewrite/tests/traffic-diagnostic.test.ts ./rewrite/tests/export-upstream-run.test.ts ./rewrite/tests/rewrite4-bun-runtime.test.ts ./test/describe-runtime/migration-ledger.test.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --config .oxlintrc.jsonc .",
    "format": "oxfmt --config .oxfmtrc.jsonc --write .",
    "validate:archive-boundary": "bun ./scripts/validate-archive-boundary.ts",
    "migration:mocha:baseline": "bun ./scripts/mocha-migration-baseline.ts",
    "migration:mocha:check-boundary": "bun ./scripts/check-mocha-oracle-boundary.ts",
    "migration:traffic:check-budget": "bun ./scripts/check-traffic-drift-budget.ts",
    "rewrite:bootstrap:candidate": "bun ./rewrite/scripts/bootstrap-fresh-candidate.ts",
    "lrsql:up": "podman compose -f compose/lrsql/podman-compose.yml up -d",
    "lrsql:down": "podman compose -f compose/lrsql/podman-compose.yml down",
    "lrsql:reset": "podman compose -f compose/lrsql/podman-compose.yml down -v && podman compose -f compose/lrsql/podman-compose.yml up -d",
    "lrsql:reset:best-effort": "bash ./scripts/lrsql-reset-best-effort.sh",
    "lrsql:logs": "podman compose -f compose/lrsql/podman-compose.yml logs --tail=200 lrs",
    "lrsql:wait": "bash ./scripts/lrsql-wait.sh",
    "lrsql:auth:check": "bash ./scripts/lrsql-auth-check.sh",
    "setup:lrsql": "bun run lrsql:up && bun run lrsql:wait && bun run lrsql:auth:check",
    "setup:lrsql:reset": "bun run lrsql:reset && bun run lrsql:wait && bun run lrsql:auth:check",
    "rewrite:export:upstream:lrsql": "bash ./rewrite/scripts/export-upstream-lrsql.sh",
    "rewrite:run:upstream:lrsql": "bash ./rewrite/scripts/run-upstream-lrsql.sh",
    "rewrite:run:upstream:lrsql:2.0.0": "XAPI_VERSION=2.0.0 bun run rewrite:run:upstream:lrsql",
    "rewrite:run:upstream:lrsql:1.0.3": "XAPI_VERSION=1.0.3 bun run rewrite:run:upstream:lrsql",
    "rewrite:analyze:upstream": "bun run ./rewrite/scripts/analyze-upstream-run.ts",
    "rewrite:diagnose:traffic": "bun ./rewrite/scripts/traffic-diagnostic.ts",
    "rewrite:replay:prefix": "bun ./rewrite/scripts/replay-traffic-prefix.ts",
    "rewrite:db:fingerprint": "bun ./rewrite/scripts/export-db-fingerprint.ts",
    "rewrite:db:compare": "bun ./rewrite/scripts/compare-db-fingerprints.ts",
    "rewrite:db:bisect": "bun ./rewrite/scripts/bisect-db-divergence.ts",
    "rewrite:db:attribute": "bun ./rewrite/scripts/attribute-db-divergence.ts",
    "rewrite:report:compare": "bun ./rewrite/scripts/analyze-compare-output.ts",
    "rewrite:diagnose:scope": "bun ./rewrite/scripts/diagnose-scope.ts",
    "rewrite:migration:phase1:inventory": "bun ./rewrite/scripts/phase1-codemod-inventory.ts",
    "rewrite:migration:phase1:inject-imports": "bun ./rewrite/scripts/codemod-inject-bun-test-imports.ts",
    "rewrite:compare": "bun ./rewrite/scripts/compare-parity.ts",
    "validate": "bun run validate:archive-boundary && bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "adl-lrs-conformance-tests": "git+https://github.com/adlnet/lrs-conformance-test-suite.git#5bc232d349c60faded8240da698f195106091638",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "zod": "^4.4.3"
  }
}
